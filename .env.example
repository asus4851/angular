# === AI analysis ===
# Без ключа використовується безкоштовний евристичний аналізатор (гірша якість)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Storage ===
DATABASE_URL=sqlite:///data/clipfactory.db
DATA_DIR=data
EXPORT_DIR=exports

# === Security ===
# Ключ шифрування креденшелів акаунтів. Згенерувати: clipfactory gen-key
SECRET_KEY=
# Опційний токен для захисту HTTP API (заголовок X-API-Key)
API_KEY=

# === Server ===
HOST=127.0.0.1
PORT=8000
# Публічний URL цього сервера (ОБОВ'ЯЗКОВО для Instagram Reels — Graph API
# завантажує відео за URL). Наприклад https://mydomain.com
PUBLIC_BASE_URL=

# === Pipeline ===
# Інтервал перевірки каналів за замовчуванням, хвилин
POLL_INTERVAL_MIN=30
# true = публікації тільки логуються, нічого не постити
DRY_RUN=false
